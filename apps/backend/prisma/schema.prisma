// ─────────────────────────────────────────────────────────────
// PHASE 7 — DATABASE IMPLEMENTATION
// Prisma schema implementing the approved Phase 3 Database Design
// (docs/DB-Model-Phase3.md) for GATE CS & IT PYQ Practice Platform
//
// Conventions (Phase 3 §2):
//   - tables/columns snake_case via @map/@@map
//   - stable fixed value sets = text + CHECK constraints (§6, §8, §13.2)
//   - extensible sets (roles, question_types, practice_modes) = lookup tables
//   - CHECK constraints live in migration SQL (Prisma cannot express them)
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// USERS & ACCESS (Phase 3 §6.1–6.4)
// ─────────────────────────────────────────────────────────────

model Role {
  id       String  @id @default(uuid(7)) @map("id")
  code     String  @unique(map: "uq_roles_code") @map("code")
  name     String  @map("name")
  isActive Boolean @default(true) @map("is_active")

  users User[]

  @@map("roles")
}

model User {
  id              String    @id @default(uuid(7)) @map("id")
  email           String    @unique(map: "uq_users_email") @map("email")
  passwordHash    String    @map("password_hash")
  roleId          String    @map("role_id")
  fullName        String    @map("full_name")
  status          String    @default("active") @map("status")
  targetSubjectId String?   @map("target_subject_id")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetSubject       Subject?             @relation("UserTargetSubject", fields: [targetSubjectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  practiceSessions    PracticeSession[]
  attempts            Attempt[]
  bookmarks           Bookmark[]
  notes               Note[]
  questionReports     QuestionReport[]
  auditLogs           AuditLog[]
  createdQuestions    Question[]           @relation("QuestionCreatedBy")
  reviewedQuestions   Question[]           @relation("QuestionReviewedBy")
  questionVersions    QuestionVersion[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid(7)) @map("id")
  userId    String    @map("user_id")
  tokenHash String    @unique(map: "uq_sessions_token_hash") @map("token_hash")
  ip        String?   @map("ip") @db.Inet
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_sessions_user_id")
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @map("id")
  userId    String    @map("user_id")
  tokenHash String    @unique(map: "uq_password_reset_tokens_token_hash") @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE / TAXONOMY (Phase 3 §6.5–6.8)
// ─────────────────────────────────────────────────────────────

model Subject {
  id        String    @id @default(uuid(7)) @map("id")
  code      String    @unique(map: "uq_subjects_code") @map("code")
  name      String    @unique(map: "uq_subjects_name") @map("name")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  chapters    Chapter[]
  topics      Topic[]
  subtopics   Subtopic[]
  questions   Question[]
  targetUsers User[]     @relation("UserTargetSubject")

  @@map("subjects")
}

model Chapter {
  id        String @id @default(uuid(7)) @map("id")
  subjectId String @map("subject_id")
  name      String @map("name")
  sortOrder Int    @default(0) @map("sort_order")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topics  Topic[]

  @@map("chapters")
}

model Topic {
  id        String  @id @default(uuid(7)) @map("id")
  subjectId String  @map("subject_id")
  chapterId String? @map("chapter_id")
  name      String  @map("name")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chapter   Chapter?   @relation(fields: [chapterId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  subtopics Subtopic[]
  questions Question[]

  @@index([subjectId], map: "ix_topics_subject_id")
  @@map("topics")
}

model Subtopic {
  id        String @id @default(uuid(7)) @map("id")
  topicId   String @map("topic_id")
  subjectId String @map("subject_id")
  name      String @map("name")

  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("subtopics")
}

// ─────────────────────────────────────────────────────────────
// QUESTIONS & CONTENT (Phase 3 §6.9–6.14)
// ─────────────────────────────────────────────────────────────

model QuestionType {
  id               String  @id @default(uuid(7)) @map("id")
  code             String  @unique(map: "uq_question_types_code") @map("code")
  name             String  @map("name")
  hasOptions       Boolean @map("has_options")
  hasNumeric       Boolean @map("has_numeric")
  supportsMultiple Boolean @map("supports_multiple")

  questions Question[]

  @@map("question_types")
}

model QuestionSource {
  id            String  @id @default(uuid(7)) @map("id")
  name          String  @unique(map: "uq_question_sources_name") @map("name")
  examYear      Int     @map("exam_year")
  paperNumber   String? @map("paper_number")
  shift         String? @map("shift")
  questionNumber Int?   @map("question_number")
  isActive      Boolean @default(true) @map("is_active")

  questions Question[]

  @@unique([examYear, paperNumber, shift, questionNumber], map: "uq_question_sources_identity")
  @@map("question_sources")
}

model Question {
  id             String   @id @default(uuid(7)) @map("id")
  questionTypeId String   @map("question_type_id")
  subjectId      String   @map("subject_id")
  topicId        String?  @map("topic_id")
  body           String   @map("body")
  explanation    String?  @map("explanation")
  marks          Decimal  @default(1) @map("marks") @db.Decimal(6, 3)
  negativeMarks  Decimal? @default(0) @map("negative_marks") @db.Decimal(6, 3)
  difficulty     String   @default("medium") @map("difficulty")
  status         String   @default("draft") @map("status")
  version        Int      @default(1) @map("version")
  gateYear       Int      @map("gate_year")
  sourceId       String?  @map("source_id")
  createdById    String   @map("created_by")
  reviewedById   String?  @map("reviewed_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  questionType   QuestionType            @relation(fields: [questionTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject        Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topic          Topic?                  @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  source         QuestionSource?         @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy      User                    @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy     User?                   @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options        QuestionOption[]
  numericAnswers QuestionNumericAnswer[]
  versions       QuestionVersion[]
  bookmarks      Bookmark[]
  notes          Note[]
  reports        QuestionReport[]

  @@index([status, topicId, gateYear], map: "ix_questions_status_published_topic")
  @@index([subjectId, status], map: "ix_questions_subject_status")
  @@map("questions")
}

model QuestionVersion {
  id          String   @id @default(uuid(7)) @map("id")
  questionId  String   @map("question_id")
  version     Int      @map("version")
  snapshot    Json     @map("snapshot")
  reason      String?  @map("reason")
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  question  Question  @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempts  Attempt[]

  @@unique([questionId, version], map: "uq_question_versions_question_id_version")
  @@index([questionId], map: "ix_question_versions_question_id")
  @@map("question_versions")
}

model QuestionOption {
  id         String  @id @default(uuid(7)) @map("id")
  questionId String  @map("question_id")
  body       String  @map("body")
  isCorrect  Boolean @default(false) @map("is_correct")
  sortOrder  Int     @map("sort_order")

  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([questionId], map: "ix_question_options_question_id")
  @@map("question_options")
}

model QuestionNumericAnswer {
  id           String   @id @default(uuid(7)) @map("id")
  questionId   String   @map("question_id")
  numericValue Decimal  @map("numeric_value") @db.Decimal(20, 8)
  toleranceAbs Decimal? @default(0) @map("tolerance_abs") @db.Decimal(20, 8)
  toleranceRel Decimal? @default(0) @map("tolerance_rel") @db.Decimal(5, 4)
  unit         String?  @map("unit")
  precision    Int?     @map("precision")

  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("question_numeric_answers")
}

// ─────────────────────────────────────────────────────────────
// PRACTICE (Phase 3 §6.15–6.17)
// ─────────────────────────────────────────────────────────────

model PracticeMode {
  id   String @id @default(uuid(7)) @map("id")
  code String @unique(map: "uq_practice_modes_code") @map("code")
  name String @map("name")

  sessions PracticeSession[]

  @@map("practice_modes")
}

model PracticeSession {
  id             String    @id @default(uuid(7)) @map("id")
  userId         String    @map("user_id")
  modeId         String    @map("mode_id")
  config         Json      @default("{}") @map("config")
  timed          Boolean   @default(false) @map("timed")
  totalQuestions Int       @map("total_questions")
  status         String    @default("in_progress") @map("status")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt        DateTime? @map("ended_at") @db.Timestamptz
  abandonedAt    DateTime? @map("abandoned_at") @db.Timestamptz
  score          Decimal?  @map("score") @db.Decimal(8, 2)

  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mode     PracticeMode @relation(fields: [modeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempts Attempt[]

  @@map("practice_sessions")
}

model Attempt {
  id                String   @id @default(uuid(7)) @map("id")
  sessionId         String   @map("session_id")
  userId            String   @map("user_id")
  questionVersionId String   @map("question_version_id")
  sequence          Int      @map("sequence")
  selectedAnswers   Json     @map("selected_answers")
  isCorrect         Boolean  @map("is_correct")
  marks             Decimal  @default(0) @map("marks") @db.Decimal(6, 2)
  timeTakenSeconds  Int      @map("time_taken_seconds")
  answeredAt        DateTime @default(now()) @map("answered_at") @db.Timestamptz
  responseVersion   Int      @default(1) @map("response_version")

  session         PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, answeredAt], map: "ix_attempts_user_id_answered_at")
  @@index([questionVersionId], map: "ix_attempts_question_version_id")
  @@index([sessionId], map: "ix_attempts_session_id")
  @@map("attempts")
}

// ─────────────────────────────────────────────────────────────
// STUDENT FEATURES (Phase 3 §6.18–6.19)
// ─────────────────────────────────────────────────────────────

model Bookmark {
  id         String   @id @default(uuid(7)) @map("id")
  userId     String   @map("user_id")
  questionId String   @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, questionId], map: "uq_bookmarks_user_question")
  @@map("bookmarks")
}

model Note {
  id         String   @id @default(uuid(7)) @map("id")
  userId     String   @map("user_id")
  questionId String   @map("question_id")
  body       String   @map("body")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("notes")
}

// ─────────────────────────────────────────────────────────────
// CONTENT ADMINISTRATION (Phase 3 §6.20–6.21)
// ─────────────────────────────────────────────────────────────

model QuestionReport {
  id             String   @id @default(uuid(7)) @map("id")
  questionId     String   @map("question_id")
  reporterUserId String   @map("reporter_user_id")
  reason         String   @map("reason")
  detail         String?  @map("detail")
  status         String   @default("open") @map("status")
  resolution     String?  @map("resolution")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  question Question @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reporter User     @relation(fields: [reporterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status], map: "ix_question_reports_status")
  @@map("question_reports")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @map("id")
  actorId    String   @map("actor_id")
  action     String   @map("action")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?    @map("before")
  after      Json?    @map("after")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId], map: "ix_audit_log_actor_id")
  @@index([entityType, entityId], map: "ix_audit_log_entity_type_entity_id")
  @@map("audit_log")
}
